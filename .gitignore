# The only file this repository commits is appcast.xml, the manifest the app reads. The zip
# it names and the installer beside it are attached to a GitHub Release and fetched by URL,
# so nothing generated belongs in the tree.

# A local test server's scratch space, and the logs the release scripts leave behind.
/tmp/
*.log

# The build output release.ps1 stages into before zipping.
/build/

# Where release.ps1 leaves the two files to attach to the release. They are uploaded, never
# committed: a 60 MB zip in git is a 60 MB zip in every clone of this repository forever.
/release/
